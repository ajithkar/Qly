# systemd unit: /etc/systemd/system/qly-api.service
# sudo systemctl daemon-reload && sudo systemctl enable --now qly-api
[Unit]
Description=Qly API (FastAPI)
After=network.target mongod.service redis-server.service
Wants=mongod.service redis-server.service

[Service]
Type=exec
User=qly
Group=qly
WorkingDirectory=/opt/qly/backend
EnvironmentFile=/opt/qly/backend/.env
ExecStart=/opt/qly/backend/.venv/bin/uvicorn app.main:app \
    --host 127.0.0.1 --port 8000 --workers 4 --proxy-headers \
    --forwarded-allow-ips='127.0.0.1'
Restart=always
RestartSec=5

# Hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/qly/backend/uploads

[Install]
WantedBy=multi-user.target
