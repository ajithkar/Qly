# --- Application ---
APP_NAME=Qly API
ENVIRONMENT=development
DEBUG=true
API_V1_PREFIX=/api/v1

# --- Datastores ---
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=qly
REDIS_URL=redis://localhost:6379/0

# --- Security ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=replace-this-with-a-long-random-value
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30
PASSWORD_MIN_LENGTH=10
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_SECONDS=900

# --- Rate limiting ---
RATE_LIMIT_ENABLED=true
RATE_LIMIT_DEFAULT_PER_MINUTE=120
RATE_LIMIT_AUTH_PER_MINUTE=10

# --- CORS (comma separated) ---
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Google OAuth (end users) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5173/auth/google/callback

# --- Queue engine ---
ETA_ROLLING_WINDOW=20
ETA_MIN_SAMPLES=3

# --- Stripe ---
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_SUCCESS_URL=http://localhost:5173/billing/success
STRIPE_CANCEL_URL=http://localhost:5173/billing/cancel

# --- Seed (first boot only) ---
SEED_ADMIN_EMAIL=admin@qly.example.com
SEED_ADMIN_PASSWORD=
