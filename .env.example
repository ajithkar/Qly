# Copy to .env before `docker compose up`.
# Generate a secret: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=dev-only-secret-change-before-production

SEED_ADMIN_EMAIL=admin@qly.example.com
SEED_ADMIN_PASSWORD=ChangeMe123

# Creates a signed-in-ready vendor with a live queue. Turn off for production.
SEED_DEMO=true
